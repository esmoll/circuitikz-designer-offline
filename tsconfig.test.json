{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "tools/.build",
		"rootDir": ".",
		"module": "CommonJS",
		"moduleResolution": "node",
		"target": "ES2022",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"include": ["src/scripts/import/**/*"],
	"exclude": ["node_modules", "tools/.build", "dist", "out"]
}